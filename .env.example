# Keep your existing .env. This file is a reference, not a replacement.
CLAUDE_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Required when your API key is not scoped to one workspace; otherwise omit.
# Find the ID in Claude Console > Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 0 = real Claude calls and real local embeddings; 1 = free offline rehearsal.
RAG_OFFLINE=0
# Cache Claude responses locally to avoid paying again for identical demos.
RAG_CACHE=1
